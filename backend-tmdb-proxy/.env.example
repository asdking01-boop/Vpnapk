# Server-side TMDb API v3 Key (or v4 Bearer Read Access Token)
# In production on Google Cloud Run, inject this via Google Cloud Secret Manager (--set-secrets="TMDB_API_KEY=TMDB_API_KEY:latest")
TMDB_API_KEY=your_server_side_tmdb_api_key_here

# Optional: Shared authentication token required via X-KRAS-Proxy-Token header, Authorization: Bearer <token>, or ?token=<token>
# Leave empty if you do not want to enforce token authentication, or set a strong random token in Secret Manager.
PROXY_AUTH_TOKEN=

# Optional: Comma-separated allowed browser origins for CORS (or * for all origins; Android OkHttp requests without Origin are always allowed)
ALLOWED_ORIGINS=*

# Optional: Sliding-window IP rate limit configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Cloud Run listening port
PORT=8080
